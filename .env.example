# .env.local로 복사해 값을 채웁니다(README "환경 변수"). 값은 커밋하지 않습니다.

# DB(Neon): 개발(dev 브랜치), 테스트(test 브랜치), 운영(production 브랜치)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
PROD_DATABASE_URL=
PROD_DATABASE_URL_UNPOOLED=

# Neon API(테스트 브랜치 초기화, 임시 브랜치)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PROD_BRANCH_ID=
NEON_DEV_BRANCH_ID=
NEON_TEST_BRANCH_ID=

# 구글 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자 이메일
ADMIN_EMAIL=

# 서버 키(무작위 32바이트, base64). 맥 밖에도 따로 보관합니다.
ACCOUNT_HASH_KEY=
PASSWORD_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# 자동 분류(Claude API)와 하루 한도
ANTHROPIC_API_KEY=
# CLASSIFY_USER_DAILY_LIMIT=500
# CLASSIFY_TOTAL_DAILY_LIMIT=3000

# 실제 샘플 확인용 카카오뱅크 파일 암호
