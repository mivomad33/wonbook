{
  "name": "wonbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:repo": "tsx scripts/checks/repo-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup-decrypt": "tsx scripts/backup-decrypt.ts",
    "db:dev-reset": "tsx scripts/dev-reset.ts",
    "test:integration": "TEST_DATABASE_URL=$(tsx test/setup-db.ts) TZ=UTC vitest run --config vitest.integration.mts",
    "check:output": "tsx scripts/checks/output-check.ts",
    "check:output-self-test": "tsx scripts/checks/output-check.ts --self-test",
    "smoke": "tsx scripts/smoke.ts",
    "release": "tsx scripts/deploy.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test:e2e": "E2E_DATABASE_URL=$(tsx test/setup-db.ts) playwright test",
    "db:import-local": "tsx scripts/import-local.ts",
    "db:import-rehearsal": "tsx scripts/import-rehearsal.ts",
    "check:db": "tsx scripts/checks/db-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@base-ui/react": "1.9.0",
    "@vercel/analytics": "2.0.1",
    "better-sqlite3": "13.0.3",
    "buffer": "6.0.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "officecrypto-tool": "0.0.19",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.26.2"
}
