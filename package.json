{
  "name": "wonbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "NODE_ENV=production tsx scripts/serve.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "dev:seed": "WONBOOK_DB_PATH=data/dev.db next dev -p 3001",
    "start:seed": "WONBOOK_DB_PATH=data/dev.db next start -p 3011",
    "make-launcher": "scripts/make-launcher.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@base-ui/react": "1.9.0",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "officecrypto-tool": "0.0.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.26.2"
}
